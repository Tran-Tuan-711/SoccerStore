@model List<ShopBanGiay_Nhom13.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
}

<style>
    .cart-box {
        width: 750px;
        margin: auto;
        padding: 15px;
        background: #f7f9fc;
        border-radius: 6px;
        border: 1px solid #d0d7e1;
    }

    h2 {
        text-align: center;
        margin-bottom: 15px;
        color: #2c3e50;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    th, td {
        border: 1px solid #ccd1d9;
        padding: 10px;
    }

    th {
        background: #3498db;
        color: white;
    }

    .right {
        text-align: right;
    }

    .center {
        text-align: center;
    }

    .btn {
        padding: 8px 14px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: bold;
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-top: 10px;
    }

    .btn-pay {
        background: #28a745;
    }

    .btn-continue {
        background: #6c757d;
    }

    .btn-back {
        background: #3498db;
    }
</style>

<div class="cart-box">
    <h2>Giỏ hàng</h2>

    @if (Model.Count == 0)
    {
        <p>Giỏ hàng trống.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-back">Quay lại mua hàng</a>
    }
    else
    {
        <form action="@Url.Action("LuuHoaDon", "Home")" method="post">
            <table>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Xóa</th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TenSP</td>
                        <td class="right">@item.Gia.ToString("N0") ₫</td>
                        <td class="center">
                            <input type="number" min="1" value="@item.SoLuong"
                                   onchange="location.href='@Url.Action("CapNhat", "Home", new { masp = item.MaSP, soluong = "__S" })'
                                   .replace('__S', this.value)" />
                        </td>
                        <td class="right">@item.ThanhTien.ToString("N0") ₫</td>
                        <td class="center">
                            <a href="@Url.Action("XoaSP", "Home", new { masp = item.MaSP })">Xóa</a>
                        </td>
                    </tr>
                }
            </table>

            <p class="right" style="margin-top:10px; font-size:18px; font-weight:bold;">
                Tổng tiền: @ViewBag.TongTien.ToString("N0") ₫
            </p>

            <input type="hidden" name="makh" value="KH001" />

            <button type="submit" class="btn btn-pay">Thanh toán</button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-continue">Tiếp tục mua hàng</a>
        </form>
    }
</div>
