<style>
    /* Các biến CSS */
    :root {
        --dark-bg: #1a1a1a;
        --text-color: #ffffff;
        --highlight-color: #a4e53e;
        --font-family: Arial, sans-serif;
    }

    /* Đảm bảo container chính luôn có chiều rộng đầy đủ */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 15px;
        padding-right: 15px;
        font-family: var(--font-family);
    }

    /* === KHỐI NỘI DUNG 2 CỘT (CONTENT) === */
    .content {
        display: flex;
        align-items: flex-start;
        margin-top: 50px;
        gap: 40px;
    }

        .content img {
            width: 50%;
            border-radius: 6px;
        }

    .text-box {
        width: 50%;
    }

    h2 {
        font-size: 26px;
        margin-bottom: 10px;
        font-weight: bold;
    }

    /* === KHỐI ƯU ĐÃI (TEAM PRINTING OFFERS) === */
    .team-printing-offers {
        background-color: var(--dark-bg);
        color: var(--text-color);
        padding: 60px 20px;
        text-align: center;
        margin-top: 50px;
    }

    .section-title {
        font-size: 28px;
        font-weight: bold;
        color: var(--text-color);
        margin-bottom: 10px;
        letter-spacing: 1.5px;
    }

    .section-description {
        font-size: 16px;
        margin-bottom: 40px;
        line-height: 1.6;
        color: #ccc;
    }

    .offers-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 30px 20px;
    }

    .offer-item {
        width: 100%;
        max-width: 300px;
        text-align: center;
    }

    .offer-icon-box {
        width: 40px;
        height: 40px;
        background-color: var(--highlight-color);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

    .offer-checkmark {
        color: var(--dark-bg);
        font-size: 24px;
        line-height: 1;
        font-weight: bold;
    }

    .offer-title {
        font-size: 18px;
        font-weight: bold;
        color: var(--highlight-color);
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .offer-detail {
        font-size: 14px;
        color: #bbb;
        line-height: 1.5;
        min-height: 45px;
    }

    /* === KHỐI MAY ĐO VÀ IN LẺ === */
    .section-title-dark {
        font-size: 24px;
        font-weight: bold;
        color: var(--text-color);
        margin-bottom: 40px;
        text-align: center;
        padding-top: 30px;
    }

    .service-flex-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 50px;
        margin-bottom: 50px;
        padding: 0 20px;
    }

    .service-image-box {
        flex: 1;
        text-align: center;
    }

        .service-image-box img {
            max-width: 100%; /* Đã sửa lỗi: dùng max-width 100% thay vì 50% */
            height: auto;
            border-radius: 6px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

    .service-text-box {
        flex: 1;
    }

        .service-text-box h3 {
            font-size: 22px;
            font-weight: bold;
            color: var(--highlight-color);
            margin-bottom: 15px;
        }

        .service-text-box p {
            font-size: 16px;
            line-height: 1.6;
            color: #bbb;
            margin-bottom: 15px;
        }

    .custom-list {
        list-style: none;
        padding-left: 0;
    }

        .custom-list li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 10px;
            font-size: 16px;
            color: var(--text-color);
        }

            .custom-list li::before {
                content: '•';
                color: var(--highlight-color);
                font-weight: bold;
                display: inline-block;
                width: 1em;
                margin-left: -1em;
                position: absolute;
                left: 0;
            }

    /* === KHỐI THƯ VIỆN ẢNH (GALLERY) === */
    .jersey-gallery {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        padding: 30px 0;
    }

    .gallery-item {
        display: block;
        overflow: hidden;
        border-radius: 4px;
        line-height: 0;
        transition: transform 0.2s ease-in-out;
    }

        .gallery-item:hover {
            transform: scale(1.03);
            z-index: 10;
            box-shadow: 0 0 10px rgba(164, 229, 62, 0.5); /* Thêm hiệu ứng nổi bật */
        }

        .gallery-item img {
            width: 100%;
            height: 200px;
            display: block;
            object-fit: cover;
        }

    /* === CSS CHO LIGHTBOX === */

    .lightbox-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.9);
        /* Kích hoạt hiển thị bằng :target */
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .lightbox-modal:target {
            display: block;
            pointer-events: auto;
            opacity: 1;
        }

    .lightbox-content {
        position: relative;
        margin: 5% auto;
        padding: 0;
        width: 90%;
        max-width: 900px;
        background-color: #111;
        border-radius: 8px;
        animation-name: zoom;
        animation-duration: 0.6s;
    }

        .lightbox-content img {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 8px 8px 0 0;
        }

    .lightbox-close {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #f1f1f1;
        font-size: 40px;
        font-weight: bold;
        transition: 0.3s;
        text-decoration: none;
        line-height: 1;
        z-index: 1001;
    }

        .lightbox-close:hover,
        .lightbox-close:focus {
            color: var(--highlight-color);
            text-decoration: none;
            cursor: pointer;
        }

    .lightbox-caption {
        padding: 10px 15px;
        text-align: center;
        color: #ccc;
        font-size: 16px;
    }

    /* Hiệu ứng zoom (tùy chọn) */
    @@keyframes zoom {
        from {
