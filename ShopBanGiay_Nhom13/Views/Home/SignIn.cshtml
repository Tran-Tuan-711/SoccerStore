@{
    ViewBag.Title = "SignIn";
    Layout = "~/Views/Shared/_LayoutKhachHang.cshtml";
}

<div class="container d-flex justify-content-center align-content-center">
    <form action="#" method="post" class="form-signin bg-success p-5 rounded-4" style="width: 400px;">
        <h3 class="text-white text-center my-3">Đăng nhập</h3>
        <div class="mb-2">
            <label class="text-white text-start mb-2 my-2 frm-label">Email</label>
            <input class="form-control w-100 d-inline-block" type="text" name="txtName" placeholder="Email" />
        </div>

        <div class="mb-2">
            <label class="text-white text-start mb-2 my-2 frm-label">Password</label>
            <input class="form-control w-100 d-inline-block" type="password" name="txtPass" placeholder="Password" />
        </div>

        <div class="text-end">
            <a class="a-link" href="#">Forgot password</a>
        </div>

        <div class="text-center my-4">
            <input class="btn btn-primary w-100" type="submit" value="Đăng nhập" />
        </div>

        <div class="my-3 text-center ">
            <span class="text-white frm-label">Not a member? </span><a class="a-link" href="/Home/SignUp">Register</a>
        </div>
    </form>
</div>

<style>
    .container{

    }
    .container .form-signin {
        border-radius: 30px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        min-height: 77vh;
        width: 80vh !important;
    }
    .frm-label{
        font-size: 16px;
    }
    .a-link {
        color: #fcd34d;
        font-size: 0.9rem;
        transition: 0.3s;
    }

    .a-link:hover {
        color: #a5f3fc;
        text-decoration: underline;
    }
</style>