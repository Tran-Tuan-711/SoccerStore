@model IEnumerable<ShopBanGiay_Nhom13.Models.Kho>

@{
    ViewBag.Title = "Product Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* HEADER */
    .dashboard-header {
        background: linear-gradient(90deg, #007bff 0%, #6610f2 100%);
        color: #fff;
        padding: 18px 25px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    }

        .dashboard-header h3 {
            font-weight: 700;
        }

    /* TABLE */
    .table-dark {
        text-align: center;
        vertical-align: middle;
    }

        .table-dark th {
            background-color: #11161c !important;
            color: #00d1b2;
            font-weight: 600;
            text-transform: uppercase;
            text-align: center;
            vertical-align: middle;
        }

        .table-dark td {
            text-align: center;
            vertical-align: middle;
            color: #e4e4e4;
        }

        .table-dark tbody tr:hover {
            background-color: rgba(13, 202, 240, 0.15);
            transition: 0.2s;
        }

    /* IMAGE */
    .product-thumb {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #333;
        transition: transform 0.3s ease;
    }

        .product-thumb:hover {
            transform: scale(1.1);
            border-color: #0dcaf0;
        }

    /* BUTTONS */
    .btn-edit {
        background-color: #0dcaf0;
        color: #000;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

        .btn-edit:hover {
            background-color: #31d2f2;
            transform: scale(1.05);
        }

    .btn-delete {
        background-color: #dc3545;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

        .btn-delete:hover {
            background-color: #ff4d5c;
            transform: scale(1.05);
        }

    .search-box, .sort-select {
        background-color: #212529;
        color: #fff;
        border: 1px solid #555;
        border-radius: 8px;
    }

    /* PAGINATION */
    .pagination {
        justify-content: center;
        margin-top: 20px;
        gap: 4px;
        flex-wrap: wrap;
    }

        .pagination button {
            background-color: #212529;
            border: 1px solid #444;
            color: #00d1b2;
            border-radius: 6px;
            padding: 6px 10px;
            min-width: 36px;
            transition: 0.2s;
        }

            .pagination button:hover {
                background-color: #0dcaf0;
                color: #000;
            }

            .pagination button.active {
                background-color: #0dcaf0;
                color: #000;
                font-weight: 700;
            }

        .pagination .disabled {
            opacity: 0.5;
            pointer-events: none;
        }
</style>

<div class="container-fluid mt-4">

    <!-- THÔNG BÁO SAU KHI XÓA -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center mt-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center mt-3">@TempData["Error"]</div>
    }

    <!-- HEADER -->
    <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fa-solid fa-boxes-stacked me-2"></i>Quản lý sản phẩm</h3>
        <div class="d-flex align-items-center">
            <input type="text" id="searchBox" class="form-control me-2 search-box" placeholder="Tìm sản phẩm..." onkeyup="filterProducts()" />
            <select id="sortSelect" class="sort-select me-3" onchange="applySort()">
                <option value="" disabled selected>Sắp xếp theo...</option>
                <option value="masp">Mã sản phẩm (A → Z)</option>
                <option value="tensp">Tên sản phẩm (A → Z)</option>
                <option value="giaAsc">Giá tăng dần</option>
                <option value="giaDesc">Giá giảm dần</option>
            </select>
            <a href="@Url.Action("Create", "Home")" class="btn btn-primary fw-bold">
                <i class="fa-solid fa-plus"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <!-- PRODUCT TABLE -->
    <div class="card bg-dark border-secondary text-light shadow-lg rounded-3">
        <div class="card-body">
            <table class="table table-dark table-striped align-middle text-center" id="productTable">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Hình ảnh</th>
                        <th>Số lượng</th>
                        <th>Giá (₫)</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr class="product-row"
                                data-masp="@item.MASP"
                                data-name="@item.TENSP"
                                data-price="@item.GIA">
                                <td>@index</td>
                                <td>@item.MASP</td>
                                <td>@item.TENSP</td>
                                <td><img src="~/Content/Images/@item.HINHANH" alt="@item.TENSP" class="product-thumb" /></td>
                                <td>@item.SOLUONG</td>
                                <td class="text-warning fw-bold">@string.Format("{0:N0}", item.GIA)</td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <a href="@Url.Action("Edit", "Home", new { id = item.MASP })"
                                           class="btn btn-edit me-2"><i class="fa-solid fa-pen-to-square me-1"></i> Sửa</a>
                                        @using (Html.BeginForm("Delete", "Home", FormMethod.Post))
                                        {
                                            @Html.Hidden("id", item.MASP)
                                            <button type="submit" class="btn btn-delete"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')">
                                                <i class="fa-solid fa-trash-can me-1"></i> Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted">Không có sản phẩm nào</td></tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination" id="pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rowsPerPage = 10;
        let currentPage = 1;

        function displayTablePage(page) {
            const rows = document.querySelectorAll(".product-row");
            const totalPages = Math.ceil(rows.length / rowsPerPage);
            currentPage = page;

            rows.forEach((row, index) => {
                row.style.display = (index >= (page - 1) * rowsPerPage && index < page * rowsPerPage) ? "" : "none";
            });

            const pagination = document.getElementById("pagination");
            pagination.innerHTML = "";

            const addButton = (label, pg, disabled = false) => {
                let btn = document.createElement("button");
                btn.innerText = label;
                if (disabled) btn.classList.add("disabled");
                if (pg === currentPage) btn.classList.add("active");
                btn.onclick = () => displayTablePage(pg);
                pagination.appendChild(btn);
            };

            addButton("«", Math.max(1, currentPage - 1), currentPage === 1);

            let start = Math.max(1, currentPage - 2);
            let end = Math.min(totalPages, currentPage + 2);

            if (start > 1) {
                addButton("1", 1);
                if (start > 2) pagination.append("...");
            }

            for (let i = start; i <= end; i++) addButton(i, i);

            if (end < totalPages) {
                if (end < totalPages - 1) pagination.append("...");
                addButton(totalPages, totalPages);
            }

            addButton("»", Math.min(totalPages, currentPage + 1), currentPage === totalPages);
        }

        function filterProducts() {
            const input = document.getElementById("searchBox").value.toLowerCase();
            const rows = document.querySelectorAll(".product-row");
            rows.forEach(row => {
                const name = row.getAttribute("data-name").toLowerCase();
                row.style.display = name.includes(input) ? "" : "none";
            });
            displayTablePage(1);
        }

        function applySort() {
            const value = document.getElementById("sortSelect").value;
            switch (value) {
                case "masp": sortTableByColumn("masp"); break;
                case "tensp": sortTableByColumn("tensp"); break;
                case "giaAsc": sortTableByPrice(true); break;
                case "giaDesc": sortTableByPrice(false); break;
            }
            displayTablePage(1);
        }

        function sortTableByColumn(type) {
            const table = document.querySelector("#tableBody");
            const rows = Array.from(table.getElementsByClassName("product-row"));
            rows.sort((a, b) => {
                const aVal = a.getAttribute(type === "masp" ? "data-masp" : "data-name").toLowerCase();
                const bVal = b.getAttribute(type === "masp" ? "data-masp" : "data-name").toLowerCase();
                return aVal.localeCompare(bVal, 'vi');
            });
            table.innerHTML = "";
            rows.forEach(r => table.appendChild(r));
        }

        function sortTableByPrice(isAsc) {
            const table = document.querySelector("#tableBody");
            const rows = Array.from(table.getElementsByClassName("product-row"));
            rows.sort((a, b) => {
                const priceA = parseInt(a.getAttribute("data-price"));
                const priceB = parseInt(b.getAttribute("data-price"));
                return isAsc ? priceA - priceB : priceB - priceA;
            });
            table.innerHTML = "";
            rows.forEach(r => table.appendChild(r));
        }

        window.onload = () => displayTablePage(1);
    </script>
}
